# ============================================
# PROJECT RE-ENTRY — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- Discord Integration (Required) ---
# Bot token from Discord Developer Portal
DISCORD_TOKEN=
# Application Client ID
DISCORD_CLIENT_ID=
# Application Client Secret (for web Discord OAuth)
DISCORD_CLIENT_SECRET=

# --- AssemblyAI Voice Agent (Required for Voice) ---
# AssemblyAI API key used server-side to mint ephemeral tokens
ASSEMBLYAI_API_KEY=
# Optional custom endpoints:
ASSEMBLYAI_AGENT_WS_URL=wss://agents.assemblyai.com/v1/ws
ASSEMBLYAI_TOKEN_URL=https://agents.assemblyai.com/v1/token

# --- NextAuth Web Authentication ---
# Generate with `openssl rand -hex 32`
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- LLM for Layer 2 Event Extraction (Optional) ---
# OpenAI, Google Gemini, or OpenAI-compatible endpoint.
# If omitted, deterministic rule-based event extraction will be used.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# --- General Settings ---
# Maximum messages to evaluate in a catch-up batch
SUMMARY_MAX_MESSAGES=100
LOG_LEVEL=info
