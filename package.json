{
  "name": "project-reentry",
  "version": "1.0.0",
  "description": "Project Re-entry — Evidence-grounded, voice-native Discord conversation re-entry agent",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:discord": "tsx src/discord/index.ts",
    "deploy:discord": "tsx src/discord/deploy-commands.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "conversation-reentry",
    "voice-agent",
    "assemblyai",
    "evidence-grounded"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "openai": "^6.39.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
